diff --git a/src/socks5_proto.rs b/src/socks5_proto.rs
new file mode 100644
index 0000000..16f543d
--- /dev/null
+++ b/src/socks5_proto.rs
@@ -0,0 +1,189 @@
+//! Minimal SOCKS5 client wire format (RFC 1928, RFC 1929) for the iOS build.
+//! Replaces the GPL-licensed `socks5-impl` crate so the distributed package stays MIT-only.
+//! Parsers return `UnexpectedEof` when a buffer is incomplete so callers can wait for more data.
+use std::io::{Error, ErrorKind, Result};
+use std::net::{Ipv4Addr, Ipv6Addr, SocketAddr};
+
+pub const VERSION: u8 = 5;
+pub const METHOD_NO_AUTH: u8 = 0;
+pub const METHOD_USER_PASS: u8 = 2;
+pub const REPLY_SUCCEEDED: u8 = 0;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub struct UserKey {
+    pub username: String,
+    pub password: String,
+}
+impl UserKey {
+    pub fn new(username: impl Into<String>, password: impl Into<String>) -> Self {
+        Self { username: username.into(), password: password.into() }
+    }
+}
+impl std::fmt::Display for UserKey {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        use percent_encoding::{utf8_percent_encode, NON_ALPHANUMERIC};
+        write!(f, "{}:{}", utf8_percent_encode(&self.username, NON_ALPHANUMERIC),
+               utf8_percent_encode(&self.password, NON_ALPHANUMERIC))
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u8)]
+pub enum Command {
+    Connect = 1,
+    UdpAssociate = 3,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Address {
+    Socket(SocketAddr),
+    Domain(String, u16),
+}
+impl Address {
+    pub fn unspecified() -> Self {
+        Self::Socket(SocketAddr::from((Ipv4Addr::UNSPECIFIED, 0)))
+    }
+    pub fn write_to(&self, out: &mut impl Extend<u8>) {
+        match self {
+            Self::Socket(SocketAddr::V4(a)) => {
+                out.extend([1]);
+                out.extend(a.ip().octets());
+                out.extend(a.port().to_be_bytes());
+            }
+            Self::Socket(SocketAddr::V6(a)) => {
+                out.extend([4]);
+                out.extend(a.ip().octets());
+                out.extend(a.port().to_be_bytes());
+            }
+            Self::Domain(name, port) => {
+                let name = &name.as_bytes()[..name.len().min(255)];
+                out.extend([3, name.len() as u8]);
+                out.extend(name.iter().copied());
+                out.extend(port.to_be_bytes());
+            }
+        }
+    }
+    /// Parses an address, returning it with the number of bytes consumed.
+    pub fn read_from(bytes: &[u8]) -> Result<(Self, usize)> {
+        let need = |n: usize| if bytes.len() < n { Err(Error::from(ErrorKind::UnexpectedEof)) } else { Ok(()) };
+        need(1)?;
+        let port = |at: usize| u16::from_be_bytes([bytes[at], bytes[at + 1]]);
+        match bytes[0] {
+            1 => {
+                need(7)?;
+                let ip = Ipv4Addr::new(bytes[1], bytes[2], bytes[3], bytes[4]);
+                Ok((Self::Socket(SocketAddr::from((ip, port(5)))), 7))
+            }
+            4 => {
+                need(19)?;
+                let mut octets = [0u8; 16];
+                octets.copy_from_slice(&bytes[1..17]);
+                Ok((Self::Socket(SocketAddr::from((Ipv6Addr::from(octets), port(17)))), 19))
+            }
+            3 => {
+                need(2)?;
+                let len = bytes[1] as usize;
+                need(4 + len)?;
+                let name = String::from_utf8_lossy(&bytes[2..2 + len]).into_owned();
+                Ok((Self::Domain(name, port(2 + len)), 4 + len))
+            }
+            other => Err(Error::new(ErrorKind::InvalidData, format!("SOCKS5 address type {other}"))),
+        }
+    }
+}
+impl From<SocketAddr> for Address {
+    fn from(addr: SocketAddr) -> Self {
+        Self::Socket(addr)
+    }
+}
+/// Client greeting offering the given authentication methods.
+pub fn greeting(methods: &[u8]) -> Vec<u8> {
+    [[VERSION, methods.len() as u8].as_slice(), methods].concat()
+}
+/// Server method selection: the chosen method and bytes consumed.
+pub fn read_method_choice(bytes: &[u8]) -> Result<(u8, usize)> {
+    if bytes.len() < 2 {
+        return Err(Error::from(ErrorKind::UnexpectedEof));
+    }
+    if bytes[0] != VERSION {
+        return Err(Error::new(ErrorKind::InvalidData, "not a SOCKS5 server"));
+    }
+    Ok((bytes[1], 2))
+}
+/// RFC 1929 username/password request.
+pub fn password_request(username: &str, password: &str) -> Result<Vec<u8>> {
+    if username.len() > 255 || password.len() > 255 {
+        return Err(Error::new(ErrorKind::InvalidInput, "SOCKS5 credentials exceed 255 bytes"));
+    }
+    Ok([&[1, username.len() as u8][..], username.as_bytes(), &[password.len() as u8], password.as_bytes()].concat())
+}
+/// CONNECT or UDP ASSOCIATE request for the given address.
+pub fn request(command: Command, address: &Address) -> Vec<u8> {
+    let mut out = vec![VERSION, command as u8, 0];
+    address.write_to(&mut out);
+    out
+}
+pub struct Reply {
+    pub code: u8,
+    pub address: Address,
+}
+/// Server reply to a request, with bytes consumed.
+pub fn read_reply(bytes: &[u8]) -> Result<(Reply, usize)> {
+    if bytes.len() < 3 {
+        return Err(Error::from(ErrorKind::UnexpectedEof));
+    }
+    if bytes[0] != VERSION {
+        return Err(Error::new(ErrorKind::InvalidData, "not a SOCKS5 reply"));
+    }
+    let (address, used) = Address::read_from(&bytes[3..])?;
+    Ok((Reply { code: bytes[1], address }, 3 + used))
+}
+pub fn reply_message(code: u8) -> &'static str {
+    match code {
+        0 => "succeeded",
+        1 => "general SOCKS server failure",
+        2 => "connection not allowed by ruleset",
+        3 => "network unreachable",
+        4 => "host unreachable",
+        5 => "connection refused",
+        6 => "TTL expired",
+        7 => "command not supported",
+        8 => "address type not supported",
+        _ => "unassigned reply code",
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn round_trips_addresses_replies_and_udp_headers() {
+        for address in [
+            Address::from("203.0.113.9:443".parse::<SocketAddr>().unwrap()),
+            Address::from("[2001:db8::1]:53".parse::<SocketAddr>().unwrap()),
+            Address::Domain("example.com".into(), 8080),
+        ] {
+            let mut bytes = Vec::new();
+            address.write_to(&mut bytes);
+            let (parsed, used) = Address::read_from(&bytes).unwrap();
+            assert!(parsed == address && used == bytes.len());
+            assert_eq!(Address::read_from(&bytes[..bytes.len() - 1]).unwrap_err().kind(), ErrorKind::UnexpectedEof);
+            // UDP ASSOCIATE datagram: RSV(2) FRAG(1) ATYP/ADDR/PORT payload.
+            let mut datagram = vec![0, 0, 0];
+            address.write_to(&mut datagram);
+            datagram.extend_from_slice(b"payload");
+            let (parsed, used) = Address::read_from(&datagram[3..]).unwrap();
+            assert!(parsed == address && &datagram[3 + used..] == b"payload");
+        }
+        assert_eq!(greeting(&[METHOD_NO_AUTH, METHOD_USER_PASS]), [5, 2, 0, 2]);
+        assert_eq!(read_method_choice(&[5, 2]).unwrap(), (2, 2));
+        assert!(read_method_choice(&[4, 0]).is_err());
+        assert_eq!(password_request("u", "p").unwrap(), [1, 1, b'u', 1, b'p']);
+        assert!(password_request(&"x".repeat(256), "p").is_err());
+        assert_eq!(request(Command::UdpAssociate, &Address::unspecified()), [5, 3, 0, 1, 0, 0, 0, 0, 0, 0]);
+        let (reply, used) = read_reply(&[5, 7, 0, 1, 127, 0, 0, 1, 0x04, 0xd2, 9]).unwrap();
+        assert!(reply.code == 7 && used == 10);
+        assert_eq!(reply.address, Address::from("127.0.0.1:1234".parse::<SocketAddr>().unwrap()));
+        assert_eq!(reply_message(7), "command not supported");
+    }
+}
